# ---- Required -----------------------------------------------------------------
# Last.fm API key (free): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Descriptive User-Agent for MusicBrainz. Use a real contact email/URL.
MUSICBRAINZ_USER_AGENT=TuneGraph/0.1 (you@example.com)

# ---- Optional: Apple Music previews ------------------------------------------
# From App Store Connect / developer.apple.com -> Certificates, IDs & Profiles -> Keys
# (create a key with "Media Services (MusicKit)" enabled; download the .p8 once).
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Either paste the PEM with newlines as \n ...
APPLE_MUSIC_PRIVATE_KEY=
# ... or point at the downloaded file (takes effect if APPLE_MUSIC_PRIVATE_KEY is empty).
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_MUSIC_STOREFRONT=us
# Keyless iTunes Search previews after MusicKit (about 20 requests/min per IP). 0 turns it off.
ITUNES_PREVIEWS=1

# ---- Optional: Spotify (outbound artist links only, no user OAuth) -----------
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- JEV via TypeSafe (server-side personal taste estimates) ----------------
# https://docs.typesafe.ai/api ; sent as "Authorization: Bearer <key>"
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-1.13.0

# ---- Optional: Google sign-in + Upstash Redis user store (#75) ---------------
# OAuth client ID (type "Web application") from Google Cloud Console -> Credentials.
# Add the site origin (and http://localhost:5173) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Upstash Redis REST credentials. The Vercel integration also sets KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random key for the session cookie signature, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SESSION_SECRET=
# Secure cookie flag. Default: on when VERCEL is set, off for local http.
# SESSION_COOKIE_SECURE=1

# ---- App ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Set to 1 to run with canned fixture data before you have any keys.
TUNEGRAPH_MOCK=0
